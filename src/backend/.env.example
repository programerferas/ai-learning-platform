# ── CORE ──────────────────────────────────────────
NODE_ENV=
PORT=

DATABASE_URL=

# ── AUTH ──────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_ISSUER=
JWT_AUDIENCE=

COOKIE_NAME=
COOKIE_DOMAIN=
CROSS_SITE_COOKIES=

# ── URLS ──────────────────────────────────────────
CLIENT_URL=
API_URL=
FRONTEND_URLS=

# ── MAIL ──────────────────────────────────────────
# EMAIL_USER هو عنوان المرسل دائماً. اختر قناة واحدة:
#  - إنتاج (Railway يحجب SMTP على الخطط المجانية/Hobby): مفاتيح Mailjet من
#    app.mailjet.com → Account settings → API Key Management، بعد توثيق EMAIL_USER
#    كمرسل في Mailjet → Sender addresses
#  - محلياً: EMAIL_PASS = كلمة مرور تطبيق Gmail (App Password)
EMAIL_USER=
EMAIL_PASS=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ── SUPABASE STORAGE (S3-compatible, presigned uploads) ──
# Storage Settings في لوحة Supabase → S3 Connection
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

# ── AI ────────────────────────────────────────────

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── ADMIN BOOTSTRAP (only for `npm run prisma:seed`, not read by the server) ──
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Strong1pass
# ADMIN_NAME=Admin
